{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "../../dist/out-tsc/ui-ecoma-logo",
    "rootDir": ".",
    "declaration": true,
    // Ghim `tsBuildInfoFile` tường minh: invariant là buildinfo của project
    // này phải nằm TRONG `outDir` riêng của lib (đã tách khỏi
    // `dist/out-tsc` dùng chung) để `tsc --build` không bao giờ trùng
    // buildinfo với project khác. Giá trị mặc định hiện tại cũng ra đúng chỗ
    // này, nhưng việc ghim tường minh giữ invariant đó bất biến khi ai đó đổi
    // `outDir`/`rootDir` mà không nghĩ tới buildinfo.
    "tsBuildInfoFile": "../../dist/out-tsc/ui-ecoma-logo/tsconfig.spec.tsbuildinfo",
    "types": ["vitest/globals", "vitest/importMeta", "vite/client", "node", "vitest"]
  },
  "include": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx",
    "src/**/*.d.ts"
  ],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    }
  ]
}
