{
  "extends": "../../tsconfig.base.json",
  "//": "lib = es2023: khớp với tsconfig.lib.json — `toSorted` chỉ có từ ES2023, và một spec project build với lib khác lib thì một file chỉ dùng API của lib mới sẽ xanh ở typecheck nhưng đỏ ở test.",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./out-tsc/vitest",
    "rootDir": ".",
    "module": "esnext",
    "moduleResolution": "bundler",
    "forceConsistentCasingInFileNames": true,
    "types": ["vitest/globals", "vitest/importMeta", "vite/client", "node"],
    "lib": ["es2023"],
    "tsBuildInfoFile": "out-tsc/vitest/tsconfig.spec.tsbuildinfo"
  },
  "include": ["vitest.config.mts", "src/**/*.test.ts", "src/**/*.spec.ts"],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    },
    {
      "path": "../web-push-notification-job-application/tsconfig.lib.json"
    }
  ]
}
