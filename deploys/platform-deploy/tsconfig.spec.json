{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "./out-tsc/vitest",
    "rootDir": "../..",
    "declaration": true,
    "types": ["vitest/globals", "vitest/importMeta", "vite/client", "node", "vitest"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "platform-down.spec.ts",
    "platform-env.spec.ts"
  ],
  "references": [
    {
      "path": "./tsconfig.json"
    }
  ]
}
