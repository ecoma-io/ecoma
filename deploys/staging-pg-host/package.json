{
  "name": "staging-pg-host",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "ecoma": {
    "deployment": {
      "status": "scaffold"
    }
  },
  "nx": {
    "implicitDependencies": [
      "platform-deploy"
    ],
    "tags": [
      "type:deployment",
      "scope:platform",
      "runtime:native"
    ],
    "targets": {
      "staging-preview": {
        "//": "Lane staging #349 (`-c staging`): tái sử dụng engine lane staging của `platform-deploy` (`staging.ts preview --project staging-pg-host`) trên stack `staging` backend R2 (`ECOMA_PULUMI_STATE_URL_STAGING`) — inventory credential fail-closed và evidence record `.staging-evidence/` là một nguồn sự thật chung, không nhân bản. Chạy với cwd `deploys/platform-deploy` vì engine resolve deps từ project đó; project dir của STACK vẫn là `deploys/staging-pg-host` (cờ `--project`). KHÔNG có target staging-down/destroy: teardown staging không có workflow (§7.4.1), checklist tay thuộc runbook #364. Cache tắt ở targetDefaults `nx.json` (CONTRACT: mutate Pulumi state staging thật).",
        "executor": "nx:run-commands",
        "options": {
          "cwd": "deploys/platform-deploy",
          "command": "npx tsx staging.ts preview --project staging-pg-host"
        },
        "configurations": {
          "staging": {}
        }
      },
      "staging-up": {
        "//": "Xem `staging-preview`: cùng lane, cùng engine, bước `pulumi up --yes` có kiểm soát qua cờ `--project`. Chỉ hai phase `preview`|`up` — down/destroy bị entry từ chối tường minh.",
        "executor": "nx:run-commands",
        "options": {
          "cwd": "deploys/platform-deploy",
          "command": "npx tsx staging.ts up --project staging-pg-host"
        },
        "configurations": {
          "staging": {}
        }
      },
      "test": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "default",
          "^production",
          {
            "fileset": "{projectRoot}/tsconfig.spec.json",
            "dependencies": true
          },
          {
            "json": "{workspaceRoot}/tsconfig.json",
            "fields": [
              "compilerOptions"
            ]
          },
          {
            "externalDependencies": [
              "vitest"
            ]
          },
          {
            "env": "CI"
          },
          {
            "dependentTasksOutputFiles": "**/*.js",
            "transitive": true
          }
        ],
        "outputs": [
          "{projectRoot}/test-output/vitest/coverage"
        ],
        "metadata": {
          "technologies": [
            "vitest"
          ],
          "description": "Run Vitest tests",
          "help": {
            "command": "pnpm exec vitest --help",
            "example": {
              "options": {
                "bail": 1,
                "coverage": true
              }
            }
          }
        },
        "options": {
          "cwd": "deploys/staging-pg-host",
          "command": "vitest run"
        },
        "configurations": {},
        "parallelism": true
      },
      "lint": {
        "executor": "@nx/oxlint:lint",
        "cache": true,
        "inputs": [
          {
            "fileset": "{projectRoot}/**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue,svelte,astro}"
          },
          {
            "fileset": "{projectRoot}/**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue,svelte,astro}",
            "dependencies": true
          },
          {
            "fileset": "{projectRoot}/package.json",
            "dependencies": true
          },
          {
            "fileset": "{projectRoot}/**/{.oxlintrc.json,.oxlintrc.jsonc,oxlint.config.ts,oxlint.config.mts,.eslintignore,.gitignore,tsconfig*.json}"
          },
          "{workspaceRoot}/.oxlintrc.json",
          "{workspaceRoot}/deploys/.eslintignore",
          "{workspaceRoot}/deploys/.gitignore",
          "{workspaceRoot}/.eslintignore",
          "{workspaceRoot}/.gitignore",
          {
            "externalDependencies": [
              "oxlint"
            ]
          }
        ],
        "metadata": {
          "technologies": [
            "oxlint"
          ],
          "description": "Runs Oxlint on project",
          "help": {
            "command": "pnpm exec oxlint --help",
            "example": {
              "options": {
                "max-warnings": 0
              }
            }
          }
        },
        "configurations": {},
        "options": {}
      },
      "typecheck": {
        "dependsOn": [
          "^typecheck"
        ],
        "cache": true,
        "inputs": [
          "production",
          {
            "dependentTasksOutputFiles": "**/*.{d.ts,d.cts,d.mts,tsbuildinfo}",
            "transitive": true
          },
          {
            "fileset": "{projectRoot}/**/*.{d.ts,d.cts,d.mts}",
            "dependencies": true
          }
        ],
        "outputs": [
          "{projectRoot}/bin/**/*.{d.ts,d.cts,d.mts}",
          "{projectRoot}/bin/deploys/staging-pg-host/tsconfig.tsbuildinfo"
        ],
        "syncGenerators": [
          "@nx/js:typescript-sync"
        ],
        "metadata": {
          "technologies": [
            "typescript"
          ],
          "description": "Runs type-checking for the project.",
          "help": {
            "command": "pnpm exec tsc --build --help",
            "example": {
              "args": [
                "--force"
              ]
            }
          }
        },
        "executor": "nx:run-commands",
        "options": {
          "cwd": "deploys/staging-pg-host",
          "command": "tsc --build tsconfig.json --emitDeclarationOnly"
        },
        "configurations": {},
        "parallelism": true
      }
    }
  }
}
