{
  "extends": "../../tsconfig.base.json",
  "//": "Composite cho emitDeclarationOnly của graph typecheck. `allowImportingTsExtensions` cho spec/harness import nhau bằng phần mở rộng thật (.ts) — cùng hình `apps/llm-api/tsconfig.spec.json`; `moduleResolution: bundler` là cặp bắt buộc của flag đó (vitest tự resolve lúc chạy). `rootDir` là chính project: spec, harness và `scripts.ts` (subject được import vào test) cùng nằm trong project.",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./out-tsc/vitest",
    "rootDir": ".",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023"],
    "allowImportingTsExtensions": true,
    "types": ["vitest/globals", "vitest/importMeta", "vite/client", "node", "vitest"],
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "tsBuildInfoFile": "out-tsc/tsconfig.spec.tsbuildinfo"
  },
  "include": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "vitest.integration.config.mts",
    "index.spec.ts",
    "index.ts",
    "local-program.ts",
    "scripts.ts",
    "scripts.spec.ts",
    "staging-program.ts",
    "staging-run.spec.ts",
    "staging-run.ts",
    "superadmin-resolver.spec.ts",
    "superadmin-resolver.ts",
    "tests/**/*.ts"
  ]
}
