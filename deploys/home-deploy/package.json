{
  "name": "home-deploy",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "dependencies": {
    "@ecoma-io/deployment": "workspace:*"
  },
  "ecoma": {
    "deployment": {
      "status": "implemented"
    }
  },
  "nx": {
    "implicitDependencies": [
      "platform-deploy",
      "@ecoma-io/deployment",
      "@ecoma-io/home"
    ],
    "tags": [
      "type:deployment",
      "scope:public",
      "runtime:native"
    ],
    "targets": {
      "local-up": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "deploys/home-deploy",
          "command": "npx tsx local.ts up"
        },
        "configurations": {
          "local": {}
        },
        "dependsOn": [
          "local-build",
          {
            "projects": [
              "platform-deploy"
            ],
            "target": "local-up"
          }
        ]
      },
      "local-down": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "deploys/home-deploy",
          "command": "npx tsx local.ts down"
        },
        "configurations": {
          "local": {}
        }
      },
      "lint": {
        "executor": "@nx/oxlint:lint",
        "cache": true,
        "inputs": [
          {
            "fileset": "{projectRoot}/**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue,svelte,astro}"
          },
          {
            "fileset": "{projectRoot}/**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue,svelte,astro}",
            "dependencies": true
          },
          {
            "fileset": "{projectRoot}/package.json",
            "dependencies": true
          },
          {
            "fileset": "{projectRoot}/**/{.oxlintrc.json,.oxlintrc.jsonc,oxlint.config.ts,oxlint.config.mts,.eslintignore,.gitignore,tsconfig*.json}"
          },
          "{workspaceRoot}/.oxlintrc.json",
          "{workspaceRoot}/deploys/.eslintignore",
          "{workspaceRoot}/deploys/.gitignore",
          "{workspaceRoot}/.eslintignore",
          "{workspaceRoot}/.gitignore",
          {
            "externalDependencies": [
              "oxlint"
            ]
          }
        ],
        "configurations": {},
        "options": {}
      },
      "typecheck": {
        "cache": true,
        "inputs": [
          "production",
          {
            "dependentTasksOutputFiles": "**/*.{d.ts,d.cts,d.mts,tsbuildinfo}",
            "transitive": true
          },
          {
            "fileset": "{projectRoot}/**/*.{d.ts,d.cts,d.mts}",
            "dependencies": true
          }
        ],
        "outputs": [
          "{projectRoot}/bin/**/*.{d.ts,d.cts,d.mts}",
          "{projectRoot}/bin/deploys/home-deploy/tsconfig.tsbuildinfo"
        ],
        "syncGenerators": [
          "@nx/js:typescript-sync"
        ],
        "executor": "nx:run-commands",
        "options": {
          "cwd": "deploys/home-deploy",
          "command": "tsc --build tsconfig.json --emitDeclarationOnly"
        },
        "configurations": {},
        "parallelism": true
      },
      "local-build": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "deploys/home-deploy",
          "command": "pnpm nx run @ecoma-io/home:build:development"
        },
        "configurations": {
          "local": {}
        },
        "cache": false
      }
    }
  }
}
