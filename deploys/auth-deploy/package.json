{
  "name": "auth-deploy",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "dependencies": {
    "@ecoma-io/deployment": "workspace:*"
  },
  "ecoma": {
    "deployment": {
      "status": "implemented"
    }
  },
  "nx": {
    "implicitDependencies": [
      "platform-deploy",
      "@ecoma-io/deployment",
      "@ecoma-io/auth",
      "@ecoma-io/account-bridge"
    ],
    "tags": [
      "type:deployment",
      "scope:auth",
      "runtime:native"
    ],
    "targets": {
      "local-up": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "deploys/auth-deploy",
          "command": "npx tsx local.ts up"
        },
        "configurations": {
          "local": {}
        },
        "dependsOn": [
          {
            "projects": [
              "platform-deploy"
            ],
            "target": "local-up"
          },
          {
            "projects": [
              "account-deploy"
            ],
            "target": "local-up"
          },
          {
            "projects": [
              "auth"
            ],
            "target": "build"
          },
          {
            "projects": [
              "account-bridge"
            ],
            "target": "build"
          }
        ]
      },
      "local-down": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "deploys/auth-deploy",
          "command": "npx tsx local.ts down"
        },
        "configurations": {
          "local": {}
        }
      },
      "staging-preview": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "deploys/auth-deploy",
          "command": "npx tsx staging.ts preview"
        },
        "configurations": {
          "staging": {}
        }
      },
      "staging-up": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "deploys/auth-deploy",
          "command": "npx tsx staging.ts up"
        },
        "configurations": {
          "staging": {}
        }
      },
      "test": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "default",
          "^production",
          {
            "fileset": "{projectRoot}/tsconfig.spec.json",
            "dependencies": true
          },
          {
            "fileset": "{projectRoot}/tsconfig.storybook.json",
            "dependencies": true
          },
          {
            "json": "{workspaceRoot}/tsconfig.json",
            "fields": [
              "compilerOptions"
            ]
          },
          {
            "externalDependencies": [
              "vitest"
            ]
          },
          {
            "env": "CI"
          },
          {
            "dependentTasksOutputFiles": "**/*.js",
            "transitive": true
          }
        ],
        "outputs": [
          "{projectRoot}/test-output/vitest/coverage"
        ],
        "options": {
          "cwd": "deploys/auth-deploy",
          "command": "vitest run"
        },
        "configurations": {},
        "parallelism": true
      },
      "test-integration": {
        "executor": "nx:run-commands",
        "cache": false,
        "dependsOn": [],
        "options": {
          "cwd": "deploys/auth-deploy",
          "command": "npx vitest run -c vitest.integration.config.mts tests/integrations"
        },
        "configurations": {}
      },
      "lint": {
        "executor": "@nx/oxlint:lint",
        "cache": true,
        "inputs": [
          {
            "fileset": "{projectRoot}/**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue,svelte,astro}"
          },
          {
            "fileset": "{projectRoot}/**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue,svelte,astro}",
            "dependencies": true
          },
          {
            "fileset": "{projectRoot}/package.json",
            "dependencies": true
          },
          {
            "fileset": "{projectRoot}/**/{.oxlintrc.json,.oxlintrc.jsonc,oxlint.config.ts,oxlint.config.mts,.eslintignore,.gitignore,tsconfig*.json}"
          },
          "{workspaceRoot}/.oxlintrc.json",
          "{workspaceRoot}/deploys/.eslintignore",
          "{workspaceRoot}/deploys/.gitignore",
          "{workspaceRoot}/.eslintignore",
          "{workspaceRoot}/.gitignore",
          {
            "externalDependencies": [
              "oxlint"
            ]
          }
        ],
        "configurations": {},
        "options": {}
      },
      "typecheck": {
        "dependsOn": [
          "^typecheck"
        ],
        "cache": true,
        "inputs": [
          "production",
          {
            "dependentTasksOutputFiles": "**/*.{d.ts,d.cts,d.mts,tsbuildinfo}",
            "transitive": true
          },
          {
            "fileset": "{projectRoot}/**/*.{d.ts,d.cts,d.mts}",
            "dependencies": true
          }
        ],
        "outputs": [
          "{projectRoot}/bin/**/*.{d.ts,d.cts,d.mts}",
          "{projectRoot}/bin/deploys/auth-deploy/tsconfig.tsbuildinfo"
        ],
        "syncGenerators": [
          "@nx/js:typescript-sync"
        ],
        "executor": "nx:run-commands",
        "options": {
          "cwd": "deploys/auth-deploy",
          "command": "tsc --build tsconfig.json --emitDeclarationOnly"
        },
        "configurations": {},
        "parallelism": true
      }
    }
  }
}
