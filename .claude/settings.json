{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/session-start.mjs",
            "statusMessage": "Resolving operator commit identity + trailer strip"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/session-start-remote.mjs",
            "statusMessage": "Provisioning the cloud sandbox toolchain (setup.mjs --yes)"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/enforce-pnpm.mjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/block-agent-attribution.mjs",
            "statusMessage": "Checking the published body for agent attribution"
          }
        ]
      },
      {
        "matcher": "mcp__github__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/block-agent-attribution.mjs",
            "statusMessage": "Checking the published body for agent attribution"
          }
        ]
      },
      {
        "matcher": "Artifact|SendUserFile",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/check-artifact-html.mjs",
            "statusMessage": "Validating artifact HTML"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/lint-edited-file.mjs",
            "statusMessage": "Linting edited file"
          }
        ]
      }
    ]
  }
}
