{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "litmus": {
      "source": {
        "source": "github",
        "repo": "ecoma-io/litmus"
      }
    }
  },
  "enabledPlugins": {
    "litmus@litmus": true
  },
  "attribution": {
    "sessionUrl": false
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/session-start.mjs",
            "statusMessage": "Resolving operator commit identity"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/session-start-remote.mjs",
            "statusMessage": "Provisioning the cloud sandbox toolchain (setup.mjs --yes)"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/enforce-pnpm.mjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/block-session-links.mjs",
            "statusMessage": "Checking the published body for a session link"
          }
        ]
      },
      {
        "matcher": "mcp__github__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/block-session-links.mjs",
            "statusMessage": "Checking the published body for a session link"
          }
        ]
      },
      {
        "matcher": "Artifact|SendUserFile",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/check-artifact-html.mjs",
            "statusMessage": "Validating artifact HTML"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/lint-edited-file.mjs",
            "statusMessage": "Linting edited file"
          }
        ]
      }
    ]
  }
}
