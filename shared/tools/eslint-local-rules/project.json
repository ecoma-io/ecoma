{
  "name": "eslint-local-rules",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "shared/tools/eslint-local-rules",
  "tags": ["type:lib", "scope:shared", "license:sul"],
  "implicitDependencies": ["dev-cli"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "eslint . --max-warnings 0 && node ../../../shared/tools/dev-cli/src/main.mjs check-journey-markers ."
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": ["default", "coverageConfig", "devCli"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "node ../../../shared/tools/dev-cli/src/main.mjs run-node-tests --test-coverage-exclude=*.test.mjs *.test.mjs"
      }
    }
  }
}
