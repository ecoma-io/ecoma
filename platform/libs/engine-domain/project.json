{
  "name": "engine-domain",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "platform/libs/engine-domain",
  "tags": ["type:lib", "scope:platform", "license:sul", "layer:domain"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "inputs": ["default", "^default", "goGlobals"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "go vet ./..."
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "inputs": ["default", "lintTooling", "goGlobals"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "node ../../../shared/tools/dev-cli/src/main.mjs check-gofmt && golangci-lint run --allow-serial-runners && eslint project.json --max-warnings 0 && node ../../../shared/tools/dev-cli/src/main.mjs check-journey-markers ."
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": ["default", "^default", "coverageConfig", "goGlobals"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "node ../../../shared/tools/dev-cli/src/main.mjs run-go-tests"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "inputs": ["production", "^production", "goGlobals"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "go build ./..."
      }
    }
  }
}
