{
  "name": "@ecoma-io/release-validation",
  "private": true,
  "type": "module",
  "dependencies": {},
  "nx": {
    "//": [
      "Tags theo schema kiến trúc bắt buộc của `tools/dx arch-tags` (chạy trong",
      "`pnpm dx arch-check`, CI chạy unconditional). Project tooling Node chạy",
      "native (node type-stripping) — cùng dimension với `tools/staging-bootstrap`.",
      "",
      "Cơ chế baseline Release Validation cho PostgreSQL — thực thi #379 theo",
      "hợp đồng `docs/architecture/02-delivery.md` §3a.6 (mục G của #373):",
      "baseline per logical database = restorable snapshot (lớp dump per-database",
      "theo `03-operations.md` §3.1 — `pg_dumpall` là cluster-level, PG1),",
      "restore-verification BẮT BUỘC trước khi baseline dùng được, candidate",
      "migrations apply từ baseline-verified trên target dùng-đi. Phục vụ release",
      "validation cho mọi service nên `scope:shared`. Wire-up vào lane Release",
      "Validation (#389) và candidate slot (#381) KHÔNG thuộc project này.",
      "D1 (mục G+) là follow-up riêng của #379."
    ],
    "tags": [
      "type:tooling",
      "runtime:native",
      "scope:shared"
    ],
    "namedInputs": {
      "default": [
        "{projectRoot}/**/*",
        "sharedGlobals"
      ]
    },
    "implicitDependencies": [
      "remote-cache-db"
    ],
    "targets": {
      "lint": {
        "executor": "@nx/oxlint:lint",
        "cache": true,
        "inputs": [
          {
            "fileset": "{projectRoot}/**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue,svelte,astro}"
          },
          {
            "fileset": "{projectRoot}/**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue,svelte,astro}",
            "dependencies": true
          },
          {
            "fileset": "{projectRoot}/package.json",
            "dependencies": true
          },
          {
            "fileset": "{projectRoot}/**/{.oxlintrc.json,.oxlintrc.jsonc,oxlint.config.ts,oxlint.config.mts,.eslintignore,.gitignore,tsconfig*.json}"
          },
          "{workspaceRoot}/.oxlintrc.json",
          "{workspaceRoot}/tools/.eslintignore",
          "{workspaceRoot}/tools/.gitignore",
          "{workspaceRoot}/.eslintignore",
          "{workspaceRoot}/.gitignore",
          {
            "externalDependencies": [
              "oxlint"
            ]
          }
        ],
        "configurations": {},
        "options": {}
      },
      "typecheck": {
        "dependsOn": [
          "^typecheck"
        ],
        "cache": true,
        "inputs": [
          "{projectRoot}/package.json",
          "{workspaceRoot}/tsconfig.base.json",
          "{projectRoot}/tsconfig.json",
          "{projectRoot}/tsconfig.lib.json",
          "{projectRoot}/tsconfig.spec.json",
          "{projectRoot}/src/**/*.ts",
          "{projectRoot}/tests/**/*.ts",
          "{projectRoot}/index.ts",
          "{projectRoot}/vite.config.ts",
          "{projectRoot}/vite.config.mts",
          "{projectRoot}/vitest.config.ts",
          "{projectRoot}/vitest.config.mts",
          "{projectRoot}/vitest.integration.config.mts",
          "{projectRoot}/src/**/*.test.ts",
          "{projectRoot}/src/**/*.spec.ts",
          "{projectRoot}/tests/**/*.spec.ts",
          "{projectRoot}/src/**/*.d.ts",
          {
            "dependentTasksOutputFiles": "**/*.{d.ts,d.cts,d.mts,tsbuildinfo}",
            "transitive": true
          },
          {
            "fileset": "{projectRoot}/**/*.{d.ts,d.cts,d.mts}",
            "dependencies": true
          },
          "^{projectRoot}/tsconfig.lib.json"
        ],
        "outputs": [
          "{projectRoot}/tsconfig.tsbuildinfo",
          "{projectRoot}/dist/**/*.{d.ts,d.cts,d.mts}",
          "{projectRoot}/dist/**/*.{d.ts,d.cts,d.mts}.map",
          "{projectRoot}/dist/tsconfig.lib.tsbuildinfo",
          "{projectRoot}/out-tsc/vitest/**/*.{d.ts,d.cts,d.mts}",
          "{projectRoot}/out-tsc/vitest/tsconfig.spec.tsbuildinfo"
        ],
        "syncGenerators": [
          "@nx/js:typescript-sync"
        ],
        "executor": "nx:run-commands",
        "options": {
          "cwd": "tools/release-validation",
          "command": "tsc --build tsconfig.json --emitDeclarationOnly"
        },
        "configurations": {},
        "parallelism": true
      },
      "test": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "default",
          "^production",
          {
            "fileset": "{projectRoot}/tsconfig.spec.json",
            "dependencies": true
          },
          {
            "json": "{workspaceRoot}/tsconfig.json",
            "fields": [
              "compilerOptions"
            ]
          },
          {
            "externalDependencies": [
              "vitest"
            ]
          },
          {
            "env": "CI"
          },
          {
            "dependentTasksOutputFiles": "**/*.js",
            "transitive": true
          }
        ],
        "outputs": [
          "{projectRoot}/test-output/vitest/coverage"
        ],
        "options": {
          "cwd": "tools/release-validation",
          "command": "vitest run"
        },
        "configurations": {},
        "parallelism": true
      },
      "test-integration": {
        "executor": "nx:run-commands",
        "cache": false,
        "dependsOn": [],
        "options": {
          "cwd": "tools/release-validation",
          "command": "npx vitest run -c vitest.integration.config.mts tests/integrations"
        },
        "configurations": {}
      }
    }
  }
}
