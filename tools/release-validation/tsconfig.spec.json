{
  "extends": "../../tsconfig.base.json",
  "//": "Composite cho emitDeclarationOnly của graph typecheck — spec unit colocated (src/*.spec.ts) VÀ suite integration (tests/integrations — tiền lệ `databases/remote-cache-db`): suite integration được typecheck cùng graph nhưng CHẠY qua target `test-integration` (Docker bắt buộc).",
  "compilerOptions": {
    "composite": true,
    "outDir": "./out-tsc/vitest",
    "rootDir": ".",
    "declaration": true,
    // Cùng lý do với tsconfig.lib.json: import `.ts` + lib es2023.
    "allowImportingTsExtensions": true,
    "emitDeclarationOnly": true,
    "tsBuildInfoFile": "out-tsc/vitest/tsconfig.spec.tsbuildinfo",
    "lib": ["es2023"],
    "types": ["vitest/globals", "vitest/importMeta", "vite/client", "node", "vitest"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "vitest.integration.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx",
    "src/**/*.d.ts",
    "tests/integrations/**/*.ts"
  ],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    }
  ]
}
