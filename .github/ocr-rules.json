{
  "include": [
    "**/*.md",
    "**/*.markdown",
    "**/*.mdx",
    "**/*.spec.{js,jsx,ts,tsx}",
    "**/*.test.{js,jsx,ts,tsx}",
    "**/*_test.py"
  ],
  "exclude": [
    "**/*.generated.*",
    "**/testdata/**",
