{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ecoma-home",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
  },
  "observability": {
    "enabled": true,
  },
  "dev": {
    "port": 4200,
  },
  // --- Staging: https://ecoma.io.vn — Worker `stg-ecoma-home` ---
  "env": {
    "staging": {
      "name": "stg-ecoma-home",
      // Hostname scheme staging (`02-delivery.md` §4.2): unit persistent gắn
      // hostname public trực tiếp bằng Custom Domain — mirror đúng production
      // (apex `ecoma.io.vn` = public web, `01` §7). Wrangler own record +
      // certificate của attachment này; Pulumi không khai record cùng hostname
      // (`staging-dns.ts` loại unit có Custom Domain khỏi record set
      // placeholder). Router non-production chỉ phục vụ slot ephemeral
      // (preview/candidate) khi được hiện thực (#350/#362).
      "routes": [{ "pattern": "ecoma.io.vn", "custom_domain": true }],
      "vars": {
        "NITRO_PUBLIC_NO_INDEX": "true",
      },
    },
    // --- Production: https://ecoma.io — Worker `ecoma-home` ---
    "production": {
      "name": "ecoma-home",
      "routes": [{ "pattern": "ecoma.io", "custom_domain": true }],
    },
  },
}
