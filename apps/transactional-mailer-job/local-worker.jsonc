{
  // Opt-in marker của local worker runtime (PR6 discovery, issue #68):
  // sự hiện diện của file này khai báo "app này chạy qua `wrangler dev` của
  // `pnpm dx local-worker-up`" — không marker nghĩa là app KHÔNG tham gia
  // runtime đó. Readiness là DECLARATION, không suy từ config wrangler:
  // queue consumer KHÔNG expose HTTP API [`01-architecture.md`] nên poll
  // `GET /health` sẽ timeout — dùng banner `Ready on http` của wrangler dev
  // (config committed không khai `workers_dev` nên inference cũ còn sai
  // thêm nhánh đó).
  "readiness": "log-banner",
  // Queue lifecycle event có producer NGOÀI repo theo thiết kế: Cloudflare
  // Event Subscriptions publish lifecycle event vào `ecoma-mail-lifecycle-events`
  // (transactional-mailer-job/01-architecture.md §11.3). Khai ở đây để orphan
  // guard của discovery không coi consumer này là lỗi cấu hình; ở local
  // runtime không có Event Subscriptions — E2E tiệm cận path ingest bằng
  // fixture producer do script sinh (tools/dx/scripts/mail-worker-runtime-e2e.mjs).
  "external_queue_producers": ["ecoma-mail-lifecycle-events"],
}
