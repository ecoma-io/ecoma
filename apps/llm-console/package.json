{
  "name": "@ecoma-io/llm-console",
  "version": "0.0.1",
  "private": true,
  "dependencies": {
    "@ecoma-io/ui-app-shell": "workspace:*",
    "@ecoma-io/ui-ecoma-logo": "workspace:*"
  },
  "devDependencies": {
    "@nuxtjs/i18n": "10.6.0"
  },
  "nx": {
    "tags": [
      "type:composition",
      "scope:llm-consumer",
      "runtime:edge"
    ],
    "targets": {
      "nuxt-prepare": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/llm-console",
          "command": "npx nuxt prepare"
        }
      },
      "typecheck": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "^typecheck",
          "nuxt-prepare"
        ],
        "cache": true,
        "inputs": [
          "default",
          "{workspaceRoot}/tsconfig.base.json",
          {
            "externalDependencies": [
              "vue-tsc"
            ]
          }
        ],
        "options": {
          "cwd": "apps/llm-console",
          "command": "npx nuxt typecheck"
        }
      },
      "test": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "default",
          "^production",
          {
            "fileset": "{projectRoot}/tsconfig.spec.json",
            "dependencies": true
          },
          {
            "fileset": "{projectRoot}/tsconfig.storybook.json",
            "dependencies": true
          },
          {
            "json": "{workspaceRoot}/tsconfig.json",
            "fields": [
              "compilerOptions"
            ]
          },
          {
            "externalDependencies": [
              "vitest"
            ]
          },
          {
            "env": "CI"
          },
          {
            "dependentTasksOutputFiles": "**/*.js",
            "transitive": true
          }
        ],
        "outputs": [
          "{projectRoot}/test-output/vitest/coverage"
        ],
        "options": {
          "cwd": "apps/llm-console",
          "command": "vitest run"
        },
        "configurations": {},
        "parallelism": true,
        "dependsOn": [
          "nuxt-prepare"
        ]
      },
      "test-integration": {
        "executor": "nx:run-commands",
        "cache": true,
        "dependsOn": [
          "build"
        ],
        "inputs": [
          "default",
          "^production",
          {
            "externalDependencies": [
              "vitest",
              "wrangler"
            ]
          },
          {
            "env": "CI"
          },
          {
            "dependentTasksOutputFiles": "**/*.{js,mjs,css,html,json}",
            "transitive": true
          }
        ],
        "outputs": [
          "{projectRoot}/test-output/vitest/coverage"
        ],
        "options": {
          "cwd": "apps/llm-console",
          "command": "npx vitest run -c vitest.integration.config.mts"
        }
      },
      "lint": {
        "executor": "@nx/oxlint:lint",
        "cache": true,
        "inputs": [
          {
            "fileset": "{projectRoot}/**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue,svelte,astro}"
          },
          {
            "fileset": "{projectRoot}/**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue,svelte,astro}",
            "dependencies": true
          },
          {
            "fileset": "{projectRoot}/package.json",
            "dependencies": true
          },
          {
            "fileset": "{projectRoot}/**/{.oxlintrc.json,.oxlintrc.jsonc,oxlint.config.ts,oxlint.config.mts,.eslintignore,.gitignore,tsconfig*.json}"
          },
          "{workspaceRoot}/.oxlintrc.json",
          "{workspaceRoot}/apps/.eslintignore",
          "{workspaceRoot}/apps/.gitignore",
          "{workspaceRoot}/.eslintignore",
          "{workspaceRoot}/.gitignore",
          {
            "externalDependencies": [
              "oxlint"
            ]
          }
        ],
        "configurations": {},
        "options": {}
      },
      "build": {
        "cache": true,
        "dependsOn": [
          "^build",
          "nuxt-prepare"
        ],
        "inputs": [
          "production",
          "^production",
          {
            "externalDependencies": [
              "nuxt"
            ]
          }
        ],
        "outputs": [
          "{projectRoot}/{options.buildDirName}",
          "{projectRoot}/{options.buildOutputDirName}"
        ],
        "executor": "nx:run-commands",
        "defaultConfiguration": "production",
        "options": {
          "cwd": "apps/llm-console",
          "command": "nuxt build",
          "buildDirName": ".nuxt",
          "buildOutputDirName": ".output"
        },
        "configurations": {
          "production": {},
          "development": {
            "command": "nuxt build --envName=node-docker",
            "buildDirName": ".nuxt-node",
            "buildOutputDirName": ".output-node"
          }
        },
        "parallelism": true
      },
      "serve": {
        "continuous": true,
        "inputs": [
          "production",
          "^production",
          {
            "externalDependencies": [
              "nuxt"
            ]
          }
        ],
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/llm-console",
          "command": "nuxt dev"
        },
        "configurations": {},
        "parallelism": true
      }
    }
  }
}
