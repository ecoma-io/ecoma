{
  "name": "@ecoma-io/llm-api",
  "private": true,
  "type": "module",
  "dependencies": {
    "@ecoma-io/llm-consumer-tenant-domain": "workspace:*",
    "@ecoma-io/llm-financial-domain": "workspace:*",
    "@ecoma-io/llm-inference-domain": "workspace:*",
    "@ecoma-io/llm-marketplace-domain": "workspace:*",
    "@ecoma-io/llm-seller-governance-domain": "workspace:*",
    "@ecoma-io/llm-seller-tenant-domain": "workspace:*",
    "@ecoma-io/llm-usage-domain": "workspace:*",
    "hono": "^4.13.13",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.2",
    "@types/pg": "^8.15.6",
    "testcontainers": "12.2.2"
  },
  "//": [
    "Deploy unit `llm-api` — data plane LLM tren Cloudflare Workers, runtime",
    "TypeScript (Hono + pg driver qua Hyperdrive), bundle esbuild ra",
    "build/index.js (Nx target `build`).",
    "`pg` nam o dependencies lam runtime driver cua Worker: mot pg.Client",
    "moi cho moi phep goi SQL duoi `src/connections.ts` (nodejs_compat bat o",
    "wrangler.jsonc; pg Pool co cache client idle qua workerd bi v o tang",
    "platform — xem ho tinh connections.ts). Khong lien quan migration",
    "runner: sau cutover #376 migration chay tu ba authority",
    "`deploys/llm-*-db` (pg devDependency cua tung project do, Node CI",
    "runner, HD6: Hyperdrive khong ho tro advisory lock).",
    "Nam domain lib `@ecoma-io/llm-*-domain` chi phuc vu bootstrap runner",
    "8a/8b, buoc 9 va buoc 10 duoi `db/` (chay tren Node qua tsx, khong thuoc",
    "bundle Worker): domain op la duong code duy nhat de seed, khong co SQL",
    "ghi du lieu tu do.",
    "`hono` la runtime HTTP cua Worker (src/index.ts).",
    "`testcontainers` chi phuc vu suite integration app-owned duoi `tests/`."
  ],
  "nx": {
    "tags": [
      "type:composition",
      "scope:llm-api",
      "runtime:edge"
    ],
    "targets": {
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "defaultConfiguration": "production",
        "options": {
          "platform": "neutral",
          "outputPath": "apps/llm-api/build",
          "format": [
            "esm"
          ],
          "bundle": true,
          "main": "apps/llm-api/src/index.ts",
          "tsConfig": "apps/llm-api/tsconfig.app.json",
          "esbuildOptions": {
            "sourcemap": true,
            "outExtension": {
              ".js": ".js"
            },
            "conditions": [
              "workerd",
              "worker",
              "browser"
            ],
            "external": [
              "node:buffer",
              "node:events",
              "node:stream"
            ]
          },
          "skipTypeCheck": true,
          "declaration": false
        },
        "configurations": {
          "development": {},
          "production": {
            "esbuildOptions": {
              "sourcemap": false,
              "outExtension": {
                ".js": ".js"
              },
              "conditions": [
                "workerd",
                "worker",
                "browser"
              ],
              "external": [
                "node:buffer",
                "node:events",
                "node:stream"
              ]
            }
          }
        }
      },
      "db:bootstrap-consumer-tenant": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "apps/llm-api",
          "command": "npx tsx --tsconfig tsconfig.db.json db/bootstrap-consumer-tenant.mts"
        }
      },
      "db:bootstrap-financial": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "apps/llm-api",
          "command": "npx tsx --tsconfig tsconfig.db.json db/bootstrap-financial.mts"
        }
      },
      "test": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/llm-api",
          "command": "npx vitest run -c vitest.config.mts"
        },
        "configurations": {},
        "parallelism": true,
        "dependsOn": []
      },
      "test-integration": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "options": {
          "cwd": "apps/llm-api",
          "command": "npx vitest run -c vitest.integration.config.mts"
        }
      },
      "lint": {
        "executor": "@nx/oxlint:lint",
        "cache": true,
        "inputs": [
          {
            "fileset": "{projectRoot}/**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue,svelte,astro}"
          },
          {
            "fileset": "{projectRoot}/**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue,svelte,astro}",
            "dependencies": true
          },
          {
            "fileset": "{projectRoot}/package.json",
            "dependencies": true
          },
          {
            "fileset": "{projectRoot}/**/{.oxlintrc.json,.oxlintrc.jsonc,oxlint.config.ts,oxlint.config.mts,.eslintignore,.gitignore,tsconfig*.json}"
          },
          "{workspaceRoot}/.oxlintrc.json",
          "{workspaceRoot}/apps/.eslintignore",
          "{workspaceRoot}/apps/.gitignore",
          "{workspaceRoot}/.eslintignore",
          "{workspaceRoot}/.gitignore",
          {
            "externalDependencies": [
              "oxlint"
            ]
          }
        ],
        "configurations": {},
        "options": {}
      },
      "typecheck": {
        "dependsOn": [
          "^typecheck"
        ],
        "cache": true,
        "inputs": [
          "{projectRoot}/package.json",
          "{workspaceRoot}/tsconfig.base.json",
          "{projectRoot}/tsconfig.db.json",
          "{projectRoot}/tsconfig.json",
          "{projectRoot}/tsconfig.app.json",
          "{projectRoot}/tsconfig.spec.json",
          "{projectRoot}/src/**/*.ts",
          "{projectRoot}/vitest.config.mts",
          "{projectRoot}/vitest.integration.config.mts",
          "{projectRoot}/tests/**/*.test.ts",
          "{projectRoot}/tests/**/*.spec.ts",
          "{projectRoot}/tests/**/*.ts",
          "{projectRoot}/db/**/*.mts",
          "!{projectRoot}/out-tsc/**/*",
          "!{projectRoot}/build/**/*",
          {
            "dependentTasksOutputFiles": "**/*.{d.ts,d.cts,d.mts,tsbuildinfo}",
            "transitive": true
          },
          {
            "fileset": "{projectRoot}/**/*.{d.ts,d.cts,d.mts}",
            "dependencies": true
          }
        ],
        "outputs": [
          "{projectRoot}/tsconfig.tsbuildinfo",
          "{projectRoot}/out-tsc/**/*.{d.ts,d.cts,d.mts}",
          "{projectRoot}/out-tsc/**/*.{d.ts,d.cts,d.mts}.map",
          "{projectRoot}/out-tsc/tsconfig.app.tsbuildinfo",
          "{projectRoot}/out-tsc/tsconfig.spec.tsbuildinfo"
        ],
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/llm-api",
          "command": "tsc --build tsconfig.json --emitDeclarationOnly && npx tsc --noEmit -p tsconfig.db.json"
        },
        "configurations": {},
        "parallelism": true
      }
    }
  }
}
