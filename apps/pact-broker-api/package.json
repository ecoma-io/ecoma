{
  "name": "@ecoma-io/pact-broker-api",
  "private": true,
  "type": "module",
  "dependencies": {
    "@ecoma-io/pact-broker-api-application": "workspace:*",
    "@ecoma-io/pact-broker-api-domain": "workspace:*",
    "@ecoma-io/pact-broker-api-infrastructure": "workspace:*",
    "@ecoma-io/staff-access-contracts": "workspace:*",
    "@ecoma-io/tenant-kernel-domain": "workspace:*",
    "hono": "^4.13.13",
    "jose": "6.2.18",
    "pg": "^8.23.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.2",
    "@types/pg": "^8.15.6",
    "testcontainers": "^12.2.1"
  },
  "//": [
    "`pg` giữ ở dependencies cho `db/bootstrap-tenant.mts` +",
    "`db/provision-machine-token.mts` — script DB chạy ở CI runner/lane (Node),",
    "không thuộc bundle Worker. Nguồn `pg` runtime của app là",
    "`@ecoma-io/pact-broker-api-infrastructure`. Migration runner đã về",
    "`deploys/pact-broker-db` (cutover #378)."
  ],
  "nx": {
    "tags": [
      "type:composition",
      "scope:pact",
      "runtime:edge"
    ],
    "targets": {
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "defaultConfiguration": "production",
        "options": {
          "platform": "neutral",
          "outputPath": "apps/pact-broker-api/dist",
          "format": [
            "esm"
          ],
          "bundle": true,
          "main": "apps/pact-broker-api/src/main.ts",
          "tsConfig": "apps/pact-broker-api/tsconfig.app.json",
          "esbuildOptions": {
            "sourcemap": true,
            "outExtension": {
              ".js": ".js"
            },
            "conditions": [
              "workerd",
              "worker",
              "browser"
            ],
            "external": [
              "node:buffer",
              "node:events",
              "node:stream"
            ]
          },
          "skipTypeCheck": true,
          "declaration": false
        },
        "configurations": {
          "development": {},
          "production": {
            "esbuildOptions": {
              "sourcemap": false,
              "outExtension": {
                ".js": ".js"
              },
              "conditions": [
                "workerd",
                "worker",
                "browser"
              ],
              "external": [
                "node:buffer",
                "node:events",
                "node:stream"
              ]
            }
          }
        }
      },
      "db:bootstrap": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "apps/pact-broker-api",
          "command": "npx tsx --tsconfig tsconfig.db.json db/bootstrap-tenant.mts"
        }
      },
      "db:provision-machine-token": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "apps/pact-broker-api",
          "command": "npx tsx --tsconfig tsconfig.db.json db/provision-machine-token.mts"
        }
      },
      "test-integration": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "options": {
          "cwd": "apps/pact-broker-api",
          "command": "npx vitest run -c vitest.integration.config.mts"
        }
      },
      "lint": {
        "executor": "@nx/oxlint:lint",
        "cache": true,
        "inputs": [
          {
            "fileset": "{projectRoot}/**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue,svelte,astro}"
          },
          {
            "fileset": "{projectRoot}/**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue,svelte,astro}",
            "dependencies": true
          },
          {
            "fileset": "{projectRoot}/package.json",
            "dependencies": true
          },
          {
            "fileset": "{projectRoot}/**/{.oxlintrc.json,.oxlintrc.jsonc,oxlint.config.ts,oxlint.config.mts,.eslintignore,.gitignore,tsconfig*.json}"
          },
          "{workspaceRoot}/.oxlintrc.json",
          "{workspaceRoot}/apps/.eslintignore",
          "{workspaceRoot}/apps/.gitignore",
          "{workspaceRoot}/.eslintignore",
          "{workspaceRoot}/.gitignore",
          {
            "externalDependencies": [
              "oxlint"
            ]
          }
        ],
        "configurations": {},
        "options": {}
      },
      "typecheck": {
        "dependsOn": [
          "^typecheck"
        ],
        "cache": true,
        "inputs": [
          "{projectRoot}/package.json",
          "{workspaceRoot}/tsconfig.base.json",
          "{projectRoot}/tsconfig.db.json",
          "{projectRoot}/tsconfig.json",
          "{projectRoot}/tsconfig.app.json",
          "{projectRoot}/tsconfig.spec.json",
          "{projectRoot}/src/**/*.ts",
          "{projectRoot}/vitest.config.mts",
          "{projectRoot}/src/**/*.test.ts",
          "{projectRoot}/src/**/*.spec.ts",
          "{projectRoot}/tests/**/*.test.ts",
          "{projectRoot}/tests/**/*.spec.ts",
          "{projectRoot}/tests/**/*.ts",
          "{projectRoot}/src/main.ts",
          "{projectRoot}/db/**/*.mts",
          "!{projectRoot}/out-tsc/**/*",
          "!{projectRoot}/dist/**/*",
          {
            "dependentTasksOutputFiles": "**/*.{d.ts,d.cts,d.mts,tsbuildinfo}",
            "transitive": true
          },
          {
            "fileset": "{projectRoot}/**/*.{d.ts,d.cts,d.mts}",
            "dependencies": true
          },
          "^{projectRoot}/tsconfig.lib.json"
        ],
        "outputs": [
          "{projectRoot}/tsconfig.tsbuildinfo",
          "{projectRoot}/out-tsc/**/*.{d.ts,d.cts,d.mts}",
          "{projectRoot}/out-tsc/**/*.{d.ts,d.cts,d.mts}.map",
          "{projectRoot}/out-tsc/tsconfig.app.tsbuildinfo",
          "{projectRoot}/out-tsc/vitest/**/*.{d.ts,d.cts,d.mts}",
          "{projectRoot}/out-tsc/tsconfig.spec.tsbuildinfo"
        ],
        "syncGenerators": [
          "@nx/js:typescript-sync"
        ],
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/pact-broker-api",
          "command": "tsc --build tsconfig.json --emitDeclarationOnly && npx tsc --noEmit -p tsconfig.db.json"
        },
        "configurations": {},
        "parallelism": true
      },
      "test": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "default",
          "^production",
          {
            "fileset": "{projectRoot}/tsconfig.spec.json",
            "dependencies": true
          },
          {
            "fileset": "{projectRoot}/tsconfig.storybook.json",
            "dependencies": true
          },
          {
            "json": "{workspaceRoot}/tsconfig.json",
            "fields": [
              "compilerOptions"
            ]
          },
          {
            "externalDependencies": [
              "vitest"
            ]
          },
          {
            "env": "CI"
          },
          {
            "dependentTasksOutputFiles": "**/*.js",
            "transitive": true
          }
        ],
        "outputs": [
          "{projectRoot}/test-output/vitest/coverage"
        ],
        "options": {
          "cwd": "apps/pact-broker-api",
          "command": "vitest run"
        },
        "configurations": {},
        "parallelism": true
      }
    }
  }
}
