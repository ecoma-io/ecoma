{
  // Control plane của mail bounded context: nhận internal API, giữ domain state
  // (template, message metadata, delivery intent, domain config) trong D1 `mail`,
  // và publish Mail Command sang Queue qua transactional outbox.
  //
  // Reference: docs/applications/transactional-mail/01-architecture.md,
  // docs/architecture/01-architecture.md (service map `transactional-mail`),
  // docs/architecture/03-operations.md §11.4.
  //
  // KHÔNG bật `nodejs_compat`: project mang tag `runtime:edge` và
  // .oxlintrc.json chặn import Node.js builtin trong mọi project `runtime:edge`.
  //
  // KHÔNG có `routes`/`hostname` public — service chỉ có internal API,
  // gọi qua Service Binding từ Worker cùng account (architecture `01` §6).
  //
  // `env.staging` khai ở khối `env` cuối file (#355): identity Worker riêng cho
  // làn staging, provisioning D1 + Queue do `deploys/transactional-mail-deploy`
  // chạy trên stack Pulumi `staging`. `env.production` CHƯA khai — production
  // không thuộc M2. Binding khai ở khối top level dưới đây KHÔNG được Wrangler
  // kế thừa vào named environment — mỗi `env.<lane>` phải khai lại binding của
  // nó tường minh, và điều kiện readiness trước khi vào matrix nằm ở overview
  // `02` §4.1/§5.2 + 03-operations.md §2.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ecoma-transactional-mail",
  "main": "dist/main.js",
  "compatibility_date": "2026-10-05",
  "observability": {
    "enabled": true,
  },

  // D1 `mail` — authoritative storage của control plane (invariant: mỗi service
  // một D1, không service nào khác đọc database này). Binding `mail` khớp
  // track D1 ở docs/architecture/02-delivery.md §3.
  //
  // `database_id` cố ý KHÔNG khai báo ở đây: chưa provisioning. Resource D1 do
  // provisioning hạ tầng tạo và cung cấp `database_id` (docs/architecture/02-delivery.md
  // §9.1) — **không** tự tạo D1 bằng `wrangler d1 create`. Wrangler chỉ được chạy
  // migration (`wrangler d1 migrations apply`).
  // Binding + vòng đời D1 của service: xem docs/applications/transactional-mail/03-operations.md §2.
  "d1_databases": [
    {
      "binding": "mail",
      "database_name": "mail",
    },
  ],

  // Producer của Queue `ecoma-mail-delivery` (tên Queue suy từ tiền lệ
  // `ecoma-push-delivery` — convention-derived, xem 01-architecture.md §6).
  // Consumer + DLQ khai báo ở apps/transactional-mailer-job/wrangler.jsonc.
  //
  // `triggers.crons` đi cùng `scheduled()` của `src/main.ts` — handler đã export
  // (publish loop → reconciler → nonce prune → retention, 01-architecture.md §6.3;
  // docs/architecture/03-operations.md §10). Giá trị nhịp là **giá trị chốt ở deploy**
  // (03-operations.md §3): `*/5 * * * *` ở đây là giá trị khởi điểm hợp lý cho publish
  // + reconciler (delay tối đa một chu kỳ cho cả hai), KHÔNG phải con số đã được load-test;
  // đổi nhịp là đổi config deploy, không phải sửa code. Prune nonce và retention chia
  // cùng nhịp — mỗi lần chạy một lô có biên, không quét cả bảng.
  //
  // `POST /internal/outbox/publish` KHÔNG phải đường thay thế đang chạy: nó
  // chưa được implement, và contract request/response cùng permission
  // `outbox.publish` còn là implementation gate (01-architecture.md §10) — chưa
  // có caller hợp lệ được định nghĩa (§7.5). Không được đọc vế này như một
  // đường backup đã sẵn sàng.
  // Trạng thái bốn tầng và điều kiện wiring: docs/applications/transactional-mail/
  // 03-operations.md §1.1.
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
  "queues": {
    "producers": [
      {
        "queue": "ecoma-mail-delivery",
        "binding": "QUEUE",
      },
    ],
  },

  // ── env.staging (#355) ───────────────────────────────────────────────────────
  // Worker identity làn staging: `stg-` + tên production (`02-delivery.md` §4.1;
  // cùng derivation mà lane deploy staging dùng chung của #535 preflight) — tên
  // Worker là vĩnh viễn, không đổi theo tag.
  //
  // ⚠️ MỖI binding phải khai lại TƯỜNG MINH trong env này — Wrangler không kế
  // thừa binding top-level (nhận xét ở đầu file), và staging KHÔNG ĐƯỢC trỏ vào
  // resource production (02-delivery.md §4.1):
  // - D1 `stg-mail` do Pulumi provision (stack `staging` của
  //   `transactional-mail-deploy`) — `database_id` cố ý KHÔNG khai: chưa
  //   provisioning, và `database_name` + thiếu `database_id` là đúng trạng thái
  //   "chưa provision" theo §9.1. Sau một lần `staging-up` xanh, id thật đọc từ
  //   `pulumi stack output mailDatabaseId` và fill vào đây — không điền id đoán
  //   hay placeholder (guard resource-bindings từ chối id toàn-zeros/rỗng).
  // - Queue producer tên `stg-ecoma-mail-delivery` — tên per-lane: Queue là tài
  //   nguyên account-unique, staging tái sử dụng tên production là vi phạm §4.1
  //   (điều kiện tách resource theo môi trường). Consumer + DLQ cùng chuỗi nằm
  //   ở apps/transactional-mailer-job/wrangler.jsonc và được provision cùng
  //   project Pulumi trên; spec hợp đồng của deploy project đối chiếu chéo hai
  //   file này.
  // - Cron KHÔNG khai lại ở đây: `triggers` được Wrangler kế thừa từ top-level.
  //
  // `workers_dev: false` — worker internal-only (không `routes`, chỉ gọi qua
  // Service Binding), workers.dev public subdomain phải tắt ở từng env.
  //
  // `vars` là giá trị vận hành ĐÃ proven trên lane local (WIC env của
  // `transactional-mail-deploy` — cùng tập script e2e chạy xanh). Secret
  // (`MAIL_FINGERPRINT_KEYRING`, `MAIL_INTERNAL_AUTH_SECRET_SVC_*`) KHÔNG nằm ở
  // file này: provision bằng Worker Secrets (`wrangler secret put` / CLI
  // `tools/dx`), thiếu secret lúc deploy là fail-closed ở loader của app.
  "env": {
    "staging": {
      "name": "stg-ecoma-transactional-mail",
      "workers_dev": false,
      "d1_databases": [
        {
          "binding": "mail",
          "database_name": "stg-mail",
        },
      ],
      "queues": {
        "producers": [
          {
            "queue": "stg-ecoma-mail-delivery",
            "binding": "QUEUE",
          },
        ],
      },
      "vars": {
        "MAIL_INTERNAL_AUTH_SKEW_SECONDS": "300",
        "MAIL_RATE_LIMIT_PRINCIPAL_LIMIT": "100",
        "MAIL_RATE_LIMIT_PRINCIPAL_WINDOW_MS": "60000",
        "MAIL_RATE_LIMIT_SYSTEM_LIMIT": "1000",
        "MAIL_RATE_LIMIT_SYSTEM_WINDOW_MS": "60000",
        "MAIL_RATE_LIMIT_KEY_LIMIT": "100",
        "MAIL_RATE_LIMIT_KEY_WINDOW_MS": "60000",
        "MAIL_RENDER_MAX_BYTES": "65536",
        "MAIL_PUBLISH_LEASE_MS": "30000",
        "MAIL_PUBLISH_BATCH_LIMIT": "10",
        "MAIL_PUBLISH_MAX_ATTEMPTS": "3",
        "MAIL_PUBLISH_BACKOFF_BASE_MS": "1000",
        "MAIL_RECONCILER_MAX_AGE_MS": "600000",
        "MAIL_RECONCILER_BATCH_LIMIT": "10",
        "MAIL_RECOVERY_MAX_CYCLES": "2",
        "MAIL_NONCE_PRUNE_BATCH_LIMIT": "100",
        "MAIL_RETENTION_CONTENT_MS": "2592000000",
        "MAIL_RETENTION_STALE_ALERT_MS": "86400000",
      },
    },
  },
}
