{
  "name": "@ecoma-io/remote-cache-api",
  "private": true,
  "type": "module",
  "dependencies": {
    "@ecoma-io/internal-auth-contracts": "workspace:*",
    "@ecoma-io/remote-cache-contracts": "workspace:*",
    "@ecoma-io/remote-cache-domain": "workspace:*",
    "@ecoma-io/remote-cache-infrastructure": "workspace:*",
    "hono": "^4.13.13",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.2",
    "@types/pg": "^8.15.6",
    "testcontainers": "12.2.2"
  },
  "//": [
    "`pg` giu o dependencies cho bootstrap CLI (`db/bootstrap-tenant.mts`) va suite",
    "integration (harness pg Client) — chay o CI runner (Node), khong thuoc bundle",
    "Worker. Nguon `pg`",
    "runtime cua app la `@ecoma-io/remote-cache-infrastructure` (postgres.js",
    "qua Hyperdrive).",
    "`hono` la runtime HTTP cua Worker; control-plane routes skeleton P4.1.",
    "`@ecoma-io/internal-auth-contracts` la protocol HMAC noi bo cua platform",
    "(scope:platform) — control plane portal xac thuc human principal bang",
    "envelope nay, khong phai contract cua bounded context nao."
  ],
  "nx": {
    "tags": [
      "type:composition",
      "scope:remote-cache",
      "runtime:edge"
    ],
    "targets": {
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "defaultConfiguration": "production",
        "options": {
          "platform": "neutral",
          "outputPath": "apps/remote-cache-api/dist",
          "format": [
            "esm"
          ],
          "bundle": true,
          "main": "apps/remote-cache-api/src/main.ts",
          "tsConfig": "apps/remote-cache-api/tsconfig.app.json",
          "esbuildOptions": {
            "sourcemap": true,
            "outExtension": {
              ".js": ".js"
            },
            "conditions": [
              "workerd",
              "worker",
              "browser"
            ],
            "external": [
              "node:buffer",
              "node:events",
              "node:stream"
            ]
          },
          "skipTypeCheck": true,
          "declaration": false
        },
        "configurations": {
          "development": {},
          "production": {
            "esbuildOptions": {
              "sourcemap": false,
              "outExtension": {
                ".js": ".js"
              },
              "conditions": [
                "workerd",
                "worker",
                "browser"
              ],
              "external": [
                "node:buffer",
                "node:events",
                "node:stream"
              ]
            }
          }
        }
      },
      "test": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/remote-cache-api",
          "command": "npx vitest run -c vitest.config.mts"
        },
        "configurations": {},
        "parallelism": true,
        "dependsOn": []
      },
      "test-integration": {
        "executor": "nx:run-commands",
        "dependsOn": [],
        "options": {
          "cwd": "apps/remote-cache-api",
          "command": "npx vitest run -c vitest.integration.config.mts"
        }
      },
      "lint": {
        "executor": "@nx/oxlint:lint",
        "cache": true,
        "inputs": [
          {
            "fileset": "{projectRoot}/**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue,svelte,astro}"
          },
          {
            "fileset": "{projectRoot}/**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue,svelte,astro}",
            "dependencies": true
          },
          {
            "fileset": "{projectRoot}/package.json",
            "dependencies": true
          },
          {
            "fileset": "{projectRoot}/**/{.oxlintrc.json,.oxlintrc.jsonc,oxlint.config.ts,oxlint.config.mts,.eslintignore,.gitignore,tsconfig*.json}"
          },
          "{workspaceRoot}/.oxlintrc.json",
          "{workspaceRoot}/apps/.eslintignore",
          "{workspaceRoot}/apps/.gitignore",
          "{workspaceRoot}/.eslintignore",
          "{workspaceRoot}/.gitignore",
          {
            "externalDependencies": [
              "oxlint"
            ]
          }
        ],
        "configurations": {},
        "options": {}
      },
      "typecheck": {
        "dependsOn": [
          "^typecheck"
        ],
        "cache": true,
        "inputs": [
          "{projectRoot}/package.json",
          "{workspaceRoot}/tsconfig.base.json",
          "{projectRoot}/tsconfig.db.json",
          "{projectRoot}/tsconfig.json",
          "{projectRoot}/tsconfig.app.json",
          "{projectRoot}/tsconfig.spec.json",
          "{projectRoot}/src/**/*.ts",
          "{projectRoot}/vitest.config.mts",
          "{projectRoot}/src/**/*.test.ts",
          "{projectRoot}/src/**/*.spec.ts",
          "{projectRoot}/tests/**/*.test.ts",
          "{projectRoot}/tests/**/*.spec.ts",
          "{projectRoot}/tests/**/*.ts",
          "{projectRoot}/src/main.ts",
          "{projectRoot}/src/config.ts",
          "{projectRoot}/db/**/*.mts",
          "{projectRoot}/smoke/**/*.mts",
          "!{projectRoot}/out-tsc/**/*",
          "!{projectRoot}/dist/**/*",
          {
            "dependentTasksOutputFiles": "**/*.{d.ts,d.cts,d.mts,tsbuildinfo}",
            "transitive": true
          },
          {
            "fileset": "{projectRoot}/**/*.{d.ts,d.cts,d.mts}",
            "dependencies": true
          },
          "^{projectRoot}/tsconfig.lib.json"
        ],
        "outputs": [
          "{projectRoot}/tsconfig.tsbuildinfo",
          "{projectRoot}/out-tsc/**/*.{d.ts,d.cts,d.mts}",
          "{projectRoot}/out-tsc/**/*.{d.ts,d.cts,d.mts}.map",
          "{projectRoot}/out-tsc/tsconfig.app.tsbuildinfo",
          "{projectRoot}/out-tsc/vitest/**/*.{d.ts,d.cts,d.mts}",
          "{projectRoot}/out-tsc/tsconfig.spec.tsbuildinfo"
        ],
        "syncGenerators": [
          "@nx/js:typescript-sync"
        ],
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/remote-cache-api",
          "command": "tsc --build tsconfig.json --emitDeclarationOnly && npx tsc --noEmit -p tsconfig.db.json"
        },
        "configurations": {},
        "parallelism": true
      }
    }
  }
}
