{
  // Worker của deploy unit `remote-cache-api` (P4.1) — control plane của bounded
  // context `remote-cache` (ADR-0015): skeleton quản lý project trong tenant
  // qua API key. Data plane (serve cache) KHÔNG thuộc Worker này (P4.2);
  // quota (P4.3) và lifecycle/hardening (P4.4) cũng vậy.
  //
  // `nodejs_compat` khai báo TƯỜNG MINH (cùng lý do `apps/staff-access`):
  // driver PostgreSQL runtime cần `node:buffer`, `node:events`, `node:stream`
  // khi chạy qua Hyperdrive. Ranh giới `runtime:edge` giữ nguyên như các Worker
  // khác: không filesystem, không process, không API ngoài những gì Workers
  // cung cấp.
  //
  // Hyperdrive binding `DB_REMOTE_CACHE` chỉ là chỗ dành: database
  // `db-remote-cache` chưa được provision (provisioning là việc của deploy unit
  // khi được dựng — ADR-0015 §"Hệ quả"), nên không có `id` thật nào được ghim —
  // cùng pattern "id chuỗi rỗng" của `apps/staff-access` và `apps/pact-broker-api`
  // (local runtime `tools/dx` chặn mọi `id` non-empty trong `hyperdrive` của
  // app đã opt-in). Connection string thật của local chạy qua biến
  // `CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_DB_REMOTE_CACHE`
  // (platform facts PF3/PF4); thiếu biến lúc `wrangler dev` là lỗi boot tường
  // minh, và deploy production thiếu binding thật vẫn fail-closed ở
  // `src/config.ts`. Query cache của Hyperdrive config này PHẢI OFF khi
  // provision (cache không invalidate khi ghi — một API key đã revoke trả về
  // từ cache là lần cấp quyền thứ hai). Migration KHÔNG chạy qua binding này —
  // chúng chạy từ CI runner bằng credential `ecoma_remote_cache_migrator`
  // (HD6: Hyperdrive không hỗ trợ advisory lock).
  "hyperdrive": [
    {
      "binding": "DB_REMOTE_CACHE",
      "id": "",
    },
  ],
  //
  // Production env KHÔNG có ở đây: production eligibility là scope M3
  // (`deploy-eligibility.jsonc` — `production` excluded toàn workspace).
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ecoma-remote-cache-api",
  "main": "dist/main.js",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["nodejs_compat"],
  // KHÔNG có `routes`/`hostname` ở top level: hostname là thuộc tính theo môi
  // trường — staging theo scheme MOD1 qua Router non-production (xem
  // `env.staging`), production thuộc scope M3.
  "observability": {
    "enabled": true,
  },
  "dev": {
    "port": 4207,
  },
  // --- Staging — Worker `stg-ecoma-remote-cache-api`, hostname MOD1
  // `remote-cache-api.ecoma.io.vn` ---
  //
  // Hostname theo scheme MOD1 (`02-delivery.md`): staging public hostname là
  // subdomain của zone non-production `ecoma.io.vn`, record do `platform-deploy`
  // suy từ inventory eligibility staging (cùng nguồn với GitHub Environments)
  // và Router non-production sở hữu route qua Service Binding — unit KHÔNG tự
  // khai `routes`/custom domain (per-unit Custom Domain đã bị loại ở A13).
  "env": {
    "staging": {
      "name": "stg-ecoma-remote-cache-api",
      // Binding khai lại theo env (Wrangler không inherit binding giữa các
      // `env.<lane>`). `id` là chuỗi rỗng CỐ Ý — cùng pattern "chỗ dành" của
      // top-level: id thật do Pulumi cung cấp sau lần `staging-up` xanh đầu
      // tiên của `remote-cache-api-deploy` (stack output `hyperdriveConfigId`),
      // operator điền vào đây; không bao giờ bịa id trong Git (guard
      // `resource-bindings` chặn id placeholder trước khi deploy).
      //
      // ⚠️ **QUERY CACHE OFF — bắt buộc** ở config Hyperdrive được provision
      // (`db-remote-cache-staging` khai `caching.disabled = true` ở
      // `deploys/remote-cache-api-deploy/staging-program.ts`), không phải ở
      // file này — lý do xem ghi chú top-level: cache không invalidate khi
      // ghi, một API key đã revoke trả về từ cache là lần cấp quyền thứ hai.
      "hyperdrive": [
        {
          "binding": "DB_REMOTE_CACHE",
          "id": "",
        },
      ],
      // Origin tất định cho smoke check (thuộc tính repo, Wrangler bỏ qua).
      "devOrigin": "https://remote-cache-api.ecoma.io.vn",
      // Object storage staging: bucket do chương trình staging của
      // `remote-cache-api-deploy` provision (`ecoma-remote-cache-staging`).
      // Worker đọc bộ `S3_*` qua env (cùng tên biến local — `src/config.ts`),
      // KHÔNG qua binding `r2_buckets` native. Ba giá trị còn lại gắn account
      // và credential nên KHÔNG nằm trong Git:
      // - `S3_ENDPOINT` — endpoint path-style R2 `https://<account_id>.r2.cloudflarestorage.com` (`04` R22);
      // - `S3_ACCESS_KEY_ID` + `S3_SECRET_ACCESS_KEY` — token R2 scope đúng một bucket (`04` R23).
      // Cả ba đặt qua `wrangler secret put` trên Worker `stg-ecoma-remote-cache-api`
      // (`tools/delivery` worker-secrets — secret không kế thừa giữa các env);
      // thiếu bất kỳ biến `S3_*` nào → storage `null`, data plane 503 fail-closed.
      "vars": {
        "S3_BUCKET": "ecoma-remote-cache-staging",
      },
    },
  },
}
