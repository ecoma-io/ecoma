{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "out-tsc",
    "module": "esnext",
    "types": ["node"],
    "lib": ["es2023", "dom"],
    "rootDir": "src",
    "moduleResolution": "bundler",
    "tsBuildInfoFile": "out-tsc/tsconfig.app.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "out-tsc",
    "dist",
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx"
  ],
  "references": [
    {
      "path": "../../libs/account-contracts/tsconfig.lib.json"
    },
    {
      "path": "../../libs/auth-contracts/tsconfig.lib.json"
    },
    {
      "path": "../../libs/auth-infrastructure/tsconfig.lib.json"
    },
    {
      "path": "../../libs/auth-domain"
    },
    {
      "path": "../../libs/auth-application"
    }
  ]
}
