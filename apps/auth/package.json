{
  "name": "@ecoma-io/auth",
  "version": "0.0.1",
  "private": true,
  "dependencies": {
    "@ecoma-io/account-contracts": "workspace:*",
    "@ecoma-io/auth-application": "workspace:*",
    "@ecoma-io/auth-contracts": "workspace:*",
    "@ecoma-io/auth-domain": "workspace:*",
    "@ecoma-io/auth-infrastructure": "workspace:*",
    "jose": "^6.2.12",
    "oidc-provider": "9.14.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.1",
    "@types/pg": "^8.23.1",
    "testcontainers": "12.2.1"
  },
  "nx": {
    "tags": [
      "type:composition",
      "scope:auth",
      "runtime:edge"
    ],
    "targets": {
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "defaultConfiguration": "production",
        "options": {
          "platform": "neutral",
          "outputPath": "apps/auth/dist",
          "format": [
            "esm"
          ],
          "bundle": true,
          "main": "apps/auth/src/main.ts",
          "tsConfig": "apps/auth/tsconfig.app.json",
          "assets": [
            "apps/auth/src/assets"
          ],
          "esbuildOptions": {
            "sourcemap": true,
            "outExtension": {
              ".js": ".js"
            },
            "conditions": [
              "workerd",
              "worker",
              "browser"
            ],
            "external": [
              "node:buffer",
              "node:events",
              "node:stream",
              "node:http",
              "cloudflare:node"
            ]
          },
          "skipTypeCheck": true,
          "declaration": false
        },
        "configurations": {
          "development": {},
          "production": {
            "esbuildOptions": {
              "sourcemap": false,
              "outExtension": {
                ".js": ".js"
              },
              "conditions": [
                "workerd",
                "worker",
                "browser"
              ],
              "external": [
                "node:buffer",
                "node:events",
                "node:stream",
                "node:http",
                "cloudflare:node"
              ]
            }
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/pnpm-workspace.yaml",
          "{workspaceRoot}/package.json",
          {
            "runtime": "node -e \"try{console.log('pnpm major '+require('child_process').execSync('pnpm --version',{stdio:['ignore','pipe','ignore']}).toString().trim().split('.')[0])}catch{console.log('pnpm major unavailable')}\""
          }
        ],
        "outputs": [
          "{workspaceRoot}/apps/auth/dist/package.json",
          "{workspaceRoot}/apps/auth/dist/pnpm-lock.yaml",
          "{workspaceRoot}/apps/auth/dist/pnpm-workspace.yaml",
          "{workspaceRoot}/apps/auth/dist/patches",
          "{workspaceRoot}/apps/auth/dist/local_path_modules"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/auth/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "db:migrate": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "apps/auth",
          "command": "npx tsx --tsconfig tsconfig.db.json db/apply.mts"
        }
      },
      "typecheck-db": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/auth",
          "command": "npx tsc --noEmit -p tsconfig.db.json"
        }
      },
      "test-integration": {
        "executor": "nx:run-commands",
        "dependsOn": [],
        "options": {
          "cwd": "apps/auth",
          "command": "npx vitest run -c vitest.integration.config.mts tests/integrations tests/databases"
        },
        "//": [
          "KHÔNG `build`: suite integration import thẳng TS nguồn — `../../src/main`,",
          "`../../src/oidc/*`, các lib qua export `./src/index.ts` của workspace. Không",
          "spec nào đọc `dist/` hay type do wrangler sinh ra; esbuild bundle chỉ tiêu",
          "thụ ở làn deploy. Gỡ `build` khỏi dependsOn bỏ chi phí bundle mà không",
          "đổi cái suite chạy."
        ]
      },
      "serve": {
        "continuous": true,
        "executor": "nx:run-commands",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "cwd": "apps/auth",
          "command": "npx wrangler dev --config wrangler.jsonc"
        },
        "configurations": {}
      },
      "lint": {
        "executor": "@nx/oxlint:lint",
        "cache": true,
        "inputs": [
          {
            "fileset": "{projectRoot}/**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue,svelte,astro}"
          },
          {
            "fileset": "{projectRoot}/**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue,svelte,astro}",
            "dependencies": true
          },
          {
            "fileset": "{projectRoot}/package.json",
            "dependencies": true
          },
          {
            "fileset": "{projectRoot}/**/{.oxlintrc.json,.oxlintrc.jsonc,oxlint.config.ts,oxlint.config.mts,.eslintignore,.gitignore,tsconfig*.json}"
          },
          "{workspaceRoot}/.oxlintrc.json",
          "{workspaceRoot}/apps/.eslintignore",
          "{workspaceRoot}/apps/.gitignore",
          "{workspaceRoot}/.eslintignore",
          "{workspaceRoot}/.gitignore",
          {
            "externalDependencies": [
              "oxlint"
            ]
          }
        ],
        "metadata": {
          "technologies": [
            "oxlint"
          ],
          "description": "Runs Oxlint on project",
          "help": {
            "command": "pnpm exec oxlint --help",
            "example": {
              "options": {
                "max-warnings": 0
              }
            }
          }
        },
        "configurations": {},
        "options": {}
      },
      "typecheck": {
        "dependsOn": [
          "^typecheck"
        ],
        "cache": true,
        "inputs": [
          "{projectRoot}/package.json",
          "{workspaceRoot}/tsconfig.base.json",
          "{projectRoot}/tsconfig.json",
          "{projectRoot}/tsconfig.app.json",
          "{projectRoot}/tsconfig.spec.json",
          "{projectRoot}/src/**/*.ts",
          "{projectRoot}/vite.config.ts",
          "{projectRoot}/vite.config.mts",
          "{projectRoot}/vitest.config.ts",
          "{projectRoot}/vitest.config.mts",
          "{projectRoot}/db/**/*.mts",
          "{projectRoot}/tests/**/*.ts",
          "{projectRoot}/src/**/*.test.ts",
          "{projectRoot}/src/**/*.spec.ts",
          "{projectRoot}/src/**/*.test.tsx",
          "{projectRoot}/src/**/*.spec.tsx",
          "{projectRoot}/src/**/*.test.js",
          "{projectRoot}/src/**/*.spec.js",
          "{projectRoot}/src/**/*.test.jsx",
          "{projectRoot}/src/**/*.spec.jsx",
          "{projectRoot}/src/**/*.d.ts",
          "!{projectRoot}/out-tsc/**/*",
          "!{projectRoot}/dist/**/*",
          {
            "dependentTasksOutputFiles": "**/*.{d.ts,d.cts,d.mts,tsbuildinfo}",
            "transitive": true
          },
          {
            "fileset": "{projectRoot}/**/*.{d.ts,d.cts,d.mts}",
            "dependencies": true
          },
          "^{projectRoot}/tsconfig.lib.json",
          "^{projectRoot}/tsconfig.json"
        ],
        "outputs": [
          "{projectRoot}/tsconfig.tsbuildinfo",
          "{projectRoot}/out-tsc/**/*.{d.ts,d.cts,d.mts}",
          "{projectRoot}/out-tsc/**/*.{d.ts,d.cts,d.mts}.map",
          "{projectRoot}/out-tsc/tsconfig.app.tsbuildinfo",
          "{projectRoot}/out-tsc/vitest/**/*.{d.ts,d.cts,d.mts}",
          "{projectRoot}/out-tsc/vitest/tsconfig.spec.tsbuildinfo"
        ],
        "syncGenerators": [
          "@nx/js:typescript-sync"
        ],
        "metadata": {
          "technologies": [
            "typescript"
          ],
          "description": "Runs type-checking for the project.",
          "help": {
            "command": "pnpm exec tsc --build --help",
            "example": {
              "args": [
                "--force"
              ]
            }
          }
        },
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/auth",
          "command": "tsc --build tsconfig.json --emitDeclarationOnly"
        },
        "configurations": {},
        "parallelism": true
      },
      "test": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "default",
          "^production",
          {
            "fileset": "{projectRoot}/tsconfig.spec.json",
            "dependencies": true
          },
          {
            "fileset": "{projectRoot}/tsconfig.storybook.json",
            "dependencies": true
          },
          {
            "json": "{workspaceRoot}/tsconfig.json",
            "fields": [
              "compilerOptions"
            ]
          },
          {
            "externalDependencies": [
              "vitest"
            ]
          },
          {
            "env": "CI"
          },
          {
            "dependentTasksOutputFiles": "**/*.js",
            "transitive": true
          }
        ],
        "outputs": [
          "{projectRoot}/test-output/vitest/coverage"
        ],
        "metadata": {
          "technologies": [
            "vitest"
          ],
          "description": "Run Vitest tests",
          "help": {
            "command": "pnpm exec vitest --help",
            "example": {
              "options": {
                "bail": 1,
                "coverage": true
              }
            }
          }
        },
        "options": {
          "cwd": "apps/auth",
          "command": "vitest"
        },
        "configurations": {},
        "parallelism": true
      }
    }
  }
}
