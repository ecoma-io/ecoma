{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "out-tsc",
    "module": "esnext",
    "types": ["node"],
    "lib": ["es2023", "dom"],
    "rootDir": "src",
    "moduleResolution": "bundler",
    "tsBuildInfoFile": "out-tsc/tsconfig.app.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "out-tsc",
    "dist",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts"
  ],
  "references": [
    { "path": "../../libs/staff-access-relay-application/tsconfig.lib.json" },
    { "path": "../../libs/staff-access-relay-infrastructure/tsconfig.lib.json" },
    { "path": "../../libs/staff-access-reconciler-application/tsconfig.lib.json" },
    { "path": "../../libs/staff-access-reconciler-infrastructure/tsconfig.lib.json" }
  ]
}
