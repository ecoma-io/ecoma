{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "./out-tsc/vitest",
    "rootDir": ".",
    "declaration": true,
    "types": ["vitest/globals", "vitest/importMeta", "vite/client", "node", "vitest"],
    "lib": ["es2023", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true
  },
  "include": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx",
    "src/**/*.d.ts",
    "tests/**/*.ts"
  ],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "../../libs/staff-access-relay-application/tsconfig.lib.json" },
    { "path": "../../libs/staff-access-relay-infrastructure/tsconfig.lib.json" }
  ]
}
