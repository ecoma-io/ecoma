{
  "name": "@ecoma-io/account",
  "version": "0.0.1",
  "private": true,
  "dependencies": {
    "@ecoma-io/account-contracts": "workspace:*",
    "@ecoma-io/account-domain": "workspace:*",
    "@ecoma-io/auth-contracts": "workspace:*",
    "@ecoma-io/internal-auth-contracts": "workspace:*",
    "@ecoma-io/transactional-mail-contracts": "workspace:*",
    "@simplewebauthn/server": "14.1.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.1",
    "@types/pg": "^8.23.1",
    "testcontainers": "12.2.1"
  },
  "nx": {
    "tags": [
      "type:composition",
      "scope:account",
      "runtime:edge"
    ],
    "targets": {
      "nuxt-prepare": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/account",
          "command": "npx nuxt prepare"
        }
      },
      "test": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "default",
          "^production",
          {
            "fileset": "{projectRoot}/tsconfig.spec.json",
            "dependencies": true
          },
          {
            "fileset": "{projectRoot}/tsconfig.storybook.json",
            "dependencies": true
          },
          {
            "json": "{workspaceRoot}/tsconfig.json",
            "fields": [
              "compilerOptions"
            ]
          },
          {
            "externalDependencies": [
              "vitest"
            ]
          },
          {
            "env": "CI"
          },
          {
            "dependentTasksOutputFiles": "**/*.js",
            "transitive": true
          }
        ],
        "outputs": [
          "{projectRoot}/test-output/vitest/coverage"
        ],
        "metadata": {
          "technologies": [
            "vitest"
          ],
          "description": "Run Vitest tests",
          "help": {
            "command": "pnpm exec vitest --help",
            "example": {
              "options": {
                "bail": 1,
                "coverage": true
              }
            }
          }
        },
        "options": {
          "cwd": "apps/account",
          "command": "vitest"
        },
        "configurations": {},
        "parallelism": true,
        "dependsOn": [
          "nuxt-prepare"
        ],
        "//": [
          "KHÔNG `build`: lane unit chạy TS nguồn (config unit exclude",
          "`tests/integrations/**`), không spec unit nào đọc `.output/` —",
          "`nitro-routes.spec.ts` duy nhất đọc bundle Nitro build thật và nó thuộc",
          "`test-integration` bên dưới, nơi `build` được giữ lại."
        ]
      },
      "db:migrate": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "apps/account",
          "command": "npx tsx --tsconfig tsconfig.db.json db/apply.mts"
        }
      },
      "test-integration": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build",
          "nuxt-prepare"
        ],
        "options": {
          "cwd": "apps/account",
          "command": "npx vitest run -c vitest.integration.config.mts tests/integrations tests/databases"
        }
      },
      "typecheck-db": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/account",
          "command": "npx tsc --noEmit -p tsconfig.db.json"
        }
      },
      "typecheck": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "^typecheck",
          "nuxt-prepare"
        ],
        "cache": true,
        "inputs": [
          "default",
          "{workspaceRoot}/tsconfig.base.json",
          {
            "externalDependencies": [
              "vue-tsc"
            ]
          }
        ],
        "options": {
          "cwd": "apps/account",
          "command": "npx nuxt typecheck"
        },
        "//": [
          "Ghi de target `typecheck` mac dinh cua plugin @nx/js (echo no-op),",
          "mirror dung cach apps/home lam: Nuxt sinh `.nuxt/tsconfig.*.json`",
          "voi `noEmit: true`, con target mac dinh chay `tsc --build",
          "`--emitDeclarationOnly` - hai option xung dot (TS5069), va truoc",
          "nuxt-prepare thi cac file do chua ton tai (TS5083). `nuxt typecheck`",
          "(vue-tsc qua @nuxt/cli) la duong dung: hieu project references Nuxt 4,",
          "dung dung cac `.nuxt/tsconfig.*.json`, va bat duoc loi type that."
        ]
      },
      "lint": {
        "executor": "@nx/oxlint:lint",
        "cache": true,
        "inputs": [
          {
            "fileset": "{projectRoot}/**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue,svelte,astro}"
          },
          {
            "fileset": "{projectRoot}/**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue,svelte,astro}",
            "dependencies": true
          },
          {
            "fileset": "{projectRoot}/package.json",
            "dependencies": true
          },
          {
            "fileset": "{projectRoot}/**/{.oxlintrc.json,.oxlintrc.jsonc,oxlint.config.ts,oxlint.config.mts,.eslintignore,.gitignore,tsconfig*.json}"
          },
          "{workspaceRoot}/.oxlintrc.json",
          "{workspaceRoot}/apps/.eslintignore",
          "{workspaceRoot}/apps/.gitignore",
          "{workspaceRoot}/.eslintignore",
          "{workspaceRoot}/.gitignore",
          {
            "externalDependencies": [
              "oxlint"
            ]
          }
        ],
        "metadata": {
          "technologies": [
            "oxlint"
          ],
          "description": "Runs Oxlint on project",
          "help": {
            "command": "pnpm exec oxlint --help",
            "example": {
              "options": {
                "max-warnings": 0
              }
            }
          }
        },
        "configurations": {},
        "options": {}
      },
      "build": {
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "production",
          "^production",
          {
            "externalDependencies": [
              "nuxt"
            ]
          }
        ],
        "outputs": [
          "{workspaceRoot}/.nuxt",
          "{projectRoot}/.output"
        ],
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/account",
          "command": "nuxt build"
        },
        "configurations": {},
        "parallelism": true
      },
      "serve": {
        "continuous": true,
        "inputs": [
          "production",
          "^production",
          {
            "externalDependencies": [
              "nuxt"
            ]
          }
        ],
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/account",
          "command": "nuxt dev"
        },
        "configurations": {},
        "parallelism": true
      }
    }
  }
}
