{
  "name": "@ecoma-io/system-tests-support",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "@ecoma-io/source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.37.0"
  },
  "nx": {
    "//": [
      "Support dùng chung cho các system-test suite (docs/architecture/06-testing.md §2:",
      "tách helper dùng chung CHỈ khi consumer và dependency tường minh). Consumer thật",
      "hiện nay là 4 suite e2e đi luồng OIDC browser (backoffice-access-control,",
      "cross-product-journey, pact-broker-portal, remote-cache-portal) — khai devDep",
      "`workspace:*` ở package.json của từng suite; runtime:native khớp runner Playwright.",
      "Không phải suite thực thi được: không có target `system-test` — chỉ lint/typecheck/test/build."
    ],
    "tags": [
      "type:tooling",
      "scope:shared",
      "runtime:native"
    ],
    "targets": {
      "lint": {
        "executor": "@nx/oxlint:lint",
        "cache": true,
        "inputs": [
          {
            "fileset": "{projectRoot}/**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue,svelte,astro}"
          },
          {
            "fileset": "{projectRoot}/**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue,svelte,astro}",
            "dependencies": true
          },
          {
            "fileset": "{projectRoot}/package.json",
            "dependencies": true
          },
          {
            "fileset": "{projectRoot}/**/{.oxlintrc.json,.oxlintrc.jsonc,oxlint.config.ts,oxlint.config.mts,.eslintignore,.gitignore,tsconfig*.json}"
          },
          "{workspaceRoot}/.oxlintrc.json",
          "{workspaceRoot}/system-tests/.eslintignore",
          "{workspaceRoot}/system-tests/.gitignore",
          "{workspaceRoot}/.eslintignore",
          "{workspaceRoot}/.gitignore",
          {
            "externalDependencies": [
              "oxlint"
            ]
          }
        ],
        "metadata": {
          "technologies": [
            "oxlint"
          ],
          "description": "Runs Oxlint on project",
          "help": {
            "command": "pnpm exec oxlint --help",
            "example": {
              "options": {
                "max-warnings": 0
              }
            }
          }
        },
        "configurations": {},
        "options": {}
      },
      "typecheck": {
        "dependsOn": [
          "build",
          "^typecheck"
        ],
        "cache": true,
        "inputs": [
          "{projectRoot}/package.json",
          "{workspaceRoot}/tsconfig.base.json",
          "{projectRoot}/tsconfig.json",
          "{projectRoot}/tsconfig.lib.json",
          "{projectRoot}/tsconfig.spec.json",
          "{projectRoot}/src/**/*.ts",
          "{projectRoot}/src/**/*.d.ts",
          "{projectRoot}/vite.config.ts",
          "{projectRoot}/vite.config.mts",
          "{projectRoot}/vitest.config.ts",
          "{projectRoot}/vitest.config.mts",
          "{projectRoot}/src/**/*.test.ts",
          "{projectRoot}/src/**/*.spec.ts",
          "{projectRoot}/src/**/*.test.tsx",
          "{projectRoot}/src/**/*.spec.tsx",
          "{projectRoot}/src/**/*.test.js",
          "{projectRoot}/src/**/*.spec.js",
          "{projectRoot}/src/**/*.test.jsx",
          "{projectRoot}/src/**/*.spec.jsx",
          {
            "dependentTasksOutputFiles": "**/*.{d.ts,d.cts,d.mts,tsbuildinfo}",
            "transitive": true
          },
          {
            "fileset": "{projectRoot}/**/*.{d.ts,d.cts,d.mts}",
            "dependencies": true
          }
        ],
        "outputs": [
          "{projectRoot}/tsconfig.tsbuildinfo",
          "{projectRoot}/dist/**/*.{d.ts,d.cts,d.mts}",
          "{projectRoot}/dist/**/*.{d.ts,d.cts,d.mts}.map",
          "{projectRoot}/dist/tsconfig.lib.tsbuildinfo",
          "{projectRoot}/out-tsc/vitest/**/*.{d.ts,d.cts,d.mts}",
          "{projectRoot}/out-tsc/vitest/tsconfig.spec.tsbuildinfo"
        ],
        "syncGenerators": [
          "@nx/js:typescript-sync"
        ],
        "metadata": {
          "technologies": [
            "typescript"
          ],
          "description": "Runs type-checking for the project.",
          "help": {
            "command": "pnpm exec tsc --build --help",
            "example": {
              "args": [
                "--force"
              ]
            }
          }
        },
        "executor": "nx:run-commands",
        "options": {
          "cwd": "system-tests/support",
          "command": "tsc --build tsconfig.json --emitDeclarationOnly"
        },
        "configurations": {},
        "parallelism": true
      },
      "test": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "default",
          "^production",
          {
            "fileset": "{projectRoot}/tsconfig.spec.json",
            "dependencies": true
          },
          {
            "fileset": "{projectRoot}/tsconfig.storybook.json",
            "dependencies": true
          },
          {
            "json": "{workspaceRoot}/tsconfig.json",
            "fields": [
              "compilerOptions"
            ]
          },
          {
            "externalDependencies": [
              "vitest"
            ]
          },
          {
            "env": "CI"
          },
          {
            "dependentTasksOutputFiles": "**/*.js",
            "transitive": true
          }
        ],
        "outputs": [
          "{projectRoot}/test-output/vitest/coverage"
        ],
        "metadata": {
          "technologies": [
            "vitest"
          ],
          "description": "Run Vitest tests",
          "help": {
            "command": "pnpm exec vitest --help",
            "example": {
              "options": {
                "bail": 1,
                "coverage": true
              }
            }
          }
        },
        "options": {
          "cwd": "system-tests/support",
          "command": "vitest"
        },
        "configurations": {},
        "parallelism": true
      },
      "build": {
        "dependsOn": [
          "^build"
        ],
        "cache": true,
        "inputs": [
          "{projectRoot}/package.json",
          "{workspaceRoot}/tsconfig.base.json",
          "{projectRoot}/tsconfig.lib.json",
          "{projectRoot}/src/**/*.ts",
          "!{projectRoot}/vite.config.ts",
          "!{projectRoot}/vite.config.mts",
          "!{projectRoot}/vitest.config.ts",
          "!{projectRoot}/vitest.config.mts",
          "!{projectRoot}/src/**/*.test.ts",
          "!{projectRoot}/src/**/*.spec.ts",
          "!{projectRoot}/src/**/*.test.tsx",
          "!{projectRoot}/src/**/*.spec.tsx",
          "!{projectRoot}/src/**/*.test.js",
          "!{projectRoot}/src/**/*.spec.js",
          "!{projectRoot}/src/**/*.test.jsx",
          "!{projectRoot}/src/**/*.spec.jsx",
          {
            "dependentTasksOutputFiles": "**/*.{d.ts,d.cts,d.mts,tsbuildinfo}",
            "transitive": true
          },
          {
            "fileset": "{projectRoot}/**/*.{d.ts,d.cts,d.mts}",
            "dependencies": true
          }
        ],
        "outputs": [
          "{projectRoot}/dist/**/*.{d.ts,d.cts,d.mts}",
          "{projectRoot}/dist/**/*.{d.ts,d.cts,d.mts}.map",
          "{projectRoot}/dist/tsconfig.lib.tsbuildinfo"
        ],
        "syncGenerators": [
          "@nx/js:typescript-sync"
        ],
        "metadata": {
          "technologies": [
            "typescript"
          ],
          "description": "Builds the project with `tsc`.",
          "help": {
            "command": "pnpm exec tsc --build --help",
            "example": {
              "args": [
                "--force"
              ]
            }
          }
        },
        "executor": "nx:run-commands",
        "options": {
          "cwd": "{projectRoot}",
          "command": "tsc --build tsconfig.lib.json"
        },
        "configurations": {}
      }
    }
  }
}
