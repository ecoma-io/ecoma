{
  "name": "@ecoma-io/home-public-e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.37.0"
  },
  "nx": {
    "//": [
      "implicitDependencies — tập deploy unit mà kết quả test phụ thuộc, suy từ code suite:",
      "- platform-deploy: cert local `deploys/platform-deploy/local-certs/fbi.com.crt` (global-setup.ts + e2e/support/local-origin.ts + playwright.config.ts đọc trực tiếp),",
      "  biến `ROOT_HOST` do `local-up` của platform ghi vào `.env`, và router Traefik của platform là chuỗi DNS/TLS/routing mà mọi test verify.",
      "- home-deploy: origin apex `https://<host>:<port>` mà suite probe (global-setup gate `GET /` 302 → `/en`; mọi spec qua baseURL) do `local-up` của home provision.",
      "Không khai account/auth/backoffice/mail/pact/push: suite không chạm origin nào của chúng và không seed container nào."
    ],
    "implicitDependencies": [
      "platform-deploy",
      "home-deploy"
    ],
    "tags": [
      "type:tooling",
      "scope:public",
      "runtime:native"
    ],
    "targets": {
      "system-test": {
        "executor": "nx:run-commands",
        "cache": false,
        "dependsOn": [
          {
            "projects": [
              "platform-deploy",
              "home-deploy"
            ],
            "target": "local-up"
          }
        ],
        "configurations": {
          "local": {}
        },
        "options": {
          "cwd": "system-tests/e2e/home-public-e2e",
          "command": "npx playwright test"
        }
      },
      "typecheck": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "default",
          "^production",
          {
            "fileset": "{projectRoot}/tsconfig.json"
          },
          {
            "externalDependencies": [
              "typescript"
            ]
          }
        ],
        "options": {
          "cwd": "system-tests/e2e/home-public-e2e",
          "command": "tsc --noEmit -p tsconfig.json"
        },
        "configurations": {},
        "parallelism": true
      },
      "lint": {
        "executor": "@nx/oxlint:lint",
        "cache": true,
        "inputs": [
          {
            "fileset": "{projectRoot}/**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue,svelte,astro}"
          },
          {
            "fileset": "{projectRoot}/**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue,svelte,astro}",
            "dependencies": true
          },
          {
            "fileset": "{projectRoot}/package.json",
            "dependencies": true
          },
          {
            "fileset": "{projectRoot}/**/{.oxlintrc.json,.oxlintrc.jsonc,oxlint.config.ts,oxlint.config.mts,.eslintignore,.gitignore,tsconfig*.json}"
          },
          "{workspaceRoot}/.oxlintrc.json",
          "{workspaceRoot}/system-tests/e2e/.eslintignore",
          "{workspaceRoot}/system-tests/e2e/.gitignore",
          "{workspaceRoot}/system-tests/.eslintignore",
          "{workspaceRoot}/system-tests/.gitignore",
          "{workspaceRoot}/.eslintignore",
          "{workspaceRoot}/.gitignore",
          {
            "externalDependencies": [
              "oxlint"
            ]
          }
        ],
        "configurations": {},
        "options": {}
      }
    }
  }
}
