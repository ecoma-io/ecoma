{
  "name": "@ecoma-io/pact-broker-portal-e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@ecoma-io/deployment": "workspace:*",
    "@ecoma-io/system-tests-support": "workspace:*",
    "@pact-foundation/pact-cli": "18.10.10",
    "@playwright/test": "^1.37.0"
  },
  "nx": {
    "//": [
      "implicitDependencies — tập deploy unit mà kết quả test phụ thuộc, suy từ code suite:",
      "- platform-deploy: cert local `deploys/platform-deploy/local-certs/fbi.com.crt` (global-setup.ts +",
      "  e2e/support/local-origin.ts + playwright.config.ts đọc trực tiếp), `ROOT_HOST` do `local-up` của",
      "  platform ghi vào `.env`, router Traefik route `pact.<host>` và `api.<host>`, và container",
      "  `ecoma-<ns>-postgres` mà e2e/support/stack-fixtures.ts seed nằm trong namespace của platform.",
      "- pact-broker-app-deploy: origin `pact.<host>` là điểm đến của toàn bộ journey UI — gate probe",
      "  `/api/broker/machine-tokens` và mọi spec điều hướng portal (login OIDC, tạo credential,",
      "  show-once, revoke, xem contract sau publish).",
      "- pact-broker-api-deploy: control plane phía sau BFF, đồng thời origin `api.<host>` là broker-base-url",
      "  của Pact CLI thật (publish, verifier, can-i-deploy) và của assertion isolation hai chiều.",
      "- auth-deploy: luồng login browser điều hướng tới authorize của issuer `auth.<host>`; client",
      "  `ecoma-pact-broker-local` với redirect_uri `pact.<host>` được seed bởi chính `local-up` của auth",
      "  (deploys/auth-deploy/index.ts).",
      "- account-deploy: browser đi qua trang login/consent UI ở origin `account.<host>`; user fixture",
      "  được seed vào `db-account` (stack-fixtures.ts::seedAccountIdentity).",
      "- transactional-mail-deploy: OTP được đọc từ mail sink D1 trong container `ecoma-<ns>-mail-wic`",
      "  (`stack-fixtures.ts::readOtpFromMailSink` docker exec vào đó) do `local-up` của mail provision.",
      "Không khai home/backoffice/remote-cache: suite không chạm origin nào của chúng."
    ],
    "implicitDependencies": [
      "platform-deploy",
      "pact-broker-app-deploy",
      "pact-broker-api-deploy",
      "auth-deploy",
      "account-deploy",
      "transactional-mail-deploy"
    ],
    "tags": [
      "type:tooling",
      "scope:pact",
      "runtime:native"
    ],
    "targets": {
      "system-test": {
        "executor": "nx:run-commands",
        "cache": false,
        "dependsOn": [
          {
            "projects": [
              "platform-deploy",
              "pact-broker-app-deploy",
              "pact-broker-api-deploy",
              "auth-deploy",
              "account-deploy",
              "transactional-mail-deploy"
            ],
            "target": "local-up"
          }
        ],
        "configurations": {
          "local": {}
        },
        "options": {
          "cwd": "system-tests/e2e/pact-broker-portal-e2e",
          "command": "npx playwright test"
        }
      },
      "typecheck": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "default",
          "^production",
          {
            "fileset": "{projectRoot}/tsconfig.json"
          },
          {
            "externalDependencies": [
              "typescript"
            ]
          }
        ],
        "options": {
          "cwd": "system-tests/e2e/pact-broker-portal-e2e",
          "command": "tsc --noEmit -p tsconfig.json"
        },
        "configurations": {},
        "parallelism": true
      },
      "lint": {
        "executor": "@nx/oxlint:lint",
        "cache": true,
        "inputs": [
          {
            "fileset": "{projectRoot}/**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue,svelte,astro}"
          },
          {
            "fileset": "{projectRoot}/**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue,svelte,astro}",
            "dependencies": true
          },
          {
            "fileset": "{projectRoot}/package.json",
            "dependencies": true
          },
          {
            "fileset": "{projectRoot}/**/{.oxlintrc.json,.oxlintrc.jsonc,oxlint.config.ts,oxlint.config.mts,.eslintignore,.gitignore,tsconfig*.json}"
          },
          "{workspaceRoot}/.oxlintrc.json",
          "{workspaceRoot}/system-tests/e2e/.eslintignore",
          "{workspaceRoot}/system-tests/e2e/.gitignore",
          "{workspaceRoot}/system-tests/.eslintignore",
          "{workspaceRoot}/system-tests/.gitignore",
          "{workspaceRoot}/.eslintignore",
          "{workspaceRoot}/.gitignore",
          {
            "externalDependencies": [
              "oxlint"
            ]
          }
        ],
        "configurations": {},
        "options": {}
      }
    }
  }
}
