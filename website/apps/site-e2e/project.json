{
  "name": "site-e2e",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "website/apps/site-e2e/src",
  "tags": ["type:e2e", "scope:website", "license:sul"],
  "implicitDependencies": ["site"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "tsc --noEmit"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "eslint . --max-warnings 0 && node ../../../shared/tools/dev-cli/src/main.mjs check-journey-markers ."
      }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "projects": ["site"], "target": "build" }],
      "inputs": ["default", "devCli"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "node ../../../shared/tools/dev-cli/src/main.mjs run-e2e"
      }
    }
  }
}
