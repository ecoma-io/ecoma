{
  "name": "site",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "website/apps/site/app",
  "tags": ["type:app", "scope:website", "license:sul"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist", "{projectRoot}/.nuxt"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "node ../../../node_modules/nuxt/bin/nuxt.mjs generate"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "node ../../../node_modules/nuxt/bin/nuxt.mjs dev --port 6010"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "vitest run"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "node ../../../node_modules/nuxt/bin/nuxt.mjs typecheck"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "eslint . --max-warnings 0 && node ../../../shared/tools/dev-cli/src/main.mjs check-journey-markers ."
      }
    },
    "verify-preview-noindex": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "node scripts/verify-preview-noindex.mjs"
      }
    }
  }
}
